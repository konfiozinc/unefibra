#!/bin/sh
# Pre-commit hook: bloquea Google API Keys y patrones de secreto en commits nuevos.
# La clave Firebase de este proyecto es publica por diseno y esta permitida.
KNOWN_KEY="AIzaSyAwQu8B6OafKszXSuL373Di4wyvotc9VWY"

added=$(git diff --cached --diff-filter=ACM -U0 | grep -E '^\+[^+]' | grep -oE 'AIza[0-9A-Za-z_-]{35}' | sort -u)

if [ -n "$added" ]; then
  for key in $added; do
    if [ "$key" != "$KNOWN_KEY" ]; then
      echo ""
      echo "ERROR: Se detecto una Google API Key no permitida en este commit: $key"
      echo "  Si es la clave Firebase de este proyecto, actualiza KNOWN_KEY en .githooks/pre-commit."
      echo "  Si es un secreto real, muevelo fuera del repositorio."
      exit 1
    fi
  done
fi

# Patrones de secreto genericos en lineas anadidas (excluye la clave conocida)
if git diff --cached --diff-filter=ACM -U0 | grep -E '^\+[^+]' | grep -vF "$KNOWN_KEY" | grep -Eq "(api[_-]?key|secret|password|token)[[:space:]]*[:=][[:space:]]*['\"][A-Za-z0-9_-]{20,}"; then
  echo ""
  echo "ADVERTENCIA: Posible secreto detectado en el commit. Revisalo antes de continuar."
  exit 1
fi

exit 0