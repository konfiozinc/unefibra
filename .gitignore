# ============================================================
# UneFibra SAS — .gitignore
# ============================================================

# Dependencias
node_modules/
functions/node_modules/

# Cloudflare Workers (cache local de wrangler)
.wrangler/
agente-ia/.wrangler/

# Firebase local
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
firestore.rules.bak

# Credenciales y secretos (JAMÁS subir al repositorio)
*serviceAccount*.json
*service-account*.json
*-service-account*.json
*private-key*.json
*.pem
.env
.env.*
!.env.example
CREDENCIALES.txt
CREDENCIALES_ADMIN.md
_*.js

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Materia prima (fotos originales del cliente sin editar)
# El repositorio es público y el sitio se publica desde él: los originales se
# quedan en disco para poder reprocesarlos, pero NO entran al repo ni al sitio.
# Las versiones optimizadas viven en assets/img/carrusel/ (esas sí se publican).
materia-prima/

# Builds
dist/
build/

# Blog público
# Se genera con `node tools/generar-blog.js` desde los artículos PUBLICADO de
# Firestore. La carpeta blog/ SÍ se versiona: así el sitio funciona aunque el
# pipeline no llegue a ejecutarse. El despliegue la regenera desde la base de
# datos, que sigue siendo la única fuente de verdad del contenido.

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Secretos y configuraciones locales
config.js
.env.local
.env.*.local
secrets.json
*.local.js

# Sistema
.DS_Store
Thumbs.db
node_modules/
